# Copy to .env.docker and adjust secrets for production.
# Used by: docker compose --profile full up
# Also used by: docker compose -f docker-compose.ghcr.yml (set GHCR_OWNER below)
#
# PRODUCTION: replace ALL placeholder secrets before exposing the stack publicly.
# See SECURITY.md.

# GitHub Container Registry (docker-compose.ghcr.yml only)
# Lowercase GitHub username or organization that owns the packages:
GHCR_OWNER=kian-malekzadeh
# Image tag from Actions (latest, semver, or sha-...)
KIA_ACADEMY_TAG=latest

# PostgreSQL (docker network hostname)
POSTGRES_USER=kia_academy
# Use a strong unique password in production — never reuse the example value publicly.
POSTGRES_PASSWORD=kia_academy
POSTGRES_DB=kia_academy
DATABASE_URL=postgresql://kia_academy:kia_academy@postgres:5432/kia_academy?schema=public

# API
PORT=3001
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
NODE_ENV=production
# Keep false in production (seed creates known demo passwords).
SEED_DATABASE=false
DB_HOST=postgres
DB_PORT=5432
DB_USER=kia_academy
TRUST_PROXY=true

# Auth — REQUIRED in production (min 32 chars, not the example placeholders below)
JWT_SECRET=replace-with-a-long-random-production-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret-32+
JWT_REFRESH_EXPIRES_IN=7d
# OTP_DEV_EXPOSE must stay unset/false in production

# Frontend: leave NEXT_PUBLIC_API_URL empty so the browser uses same-origin /api,
# proxied by Next to the API container.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_PROXY_TARGET=http://api:3001

# Stripe (optional)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Email / SMTP (optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Kia Academy <noreply@kia.academy>
